# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# windows / onedrive
desktop.ini

# local tool state: Claude Code worktrees and personal settings, Supabase CLI cache
.claude/worktrees/
.claude/settings.local.json
.claude/launch.json
supabase/.temp/

# Local only: kept on developers' machines, never in the repository Vercel deploys.
# Tests
*.test.ts
*.test.tsx
*.test.js
*.test.mjs
# Seed data and demo-data tooling (the scripts import the seed code, so they go together)
/scripts/seed-*
/scripts/clear-tenant-cli.ts
/scripts/fix-guest-stay-fixture-*.ts
/scripts/validate-demo-schema.ts
/src/lib/hms/seed/
/src/lib/store/seed/
/src/app/api/hotel/seed-demo/
/supabase/seed*.sql
# Internal documents and the static template sources
/docs/
/design/
/*.pdf
/*.docx
